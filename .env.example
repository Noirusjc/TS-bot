# ═══════════════════════════════════════════════════════════════════
#  TS3 Management Bot — Environment Variables
# ═══════════════════════════════════════════════════════════════════
#
#  RAILWAY DEPLOYMENT: Only the two variables below are required
#  before first deploy. Everything else is configured through the
#  First-Time Setup Wizard at your Railway public domain.
#
#  DATABASE_URL  → Set automatically by Railway when you add a
#                  PostgreSQL service and link it to this app.
#  SESSION_SECRET → Set this manually in Railway Variables.
#
# ═══════════════════════════════════════════════════════════════════

# ── REQUIRED ────────────────────────────────────────────────────────

# PostgreSQL connection string.
# On Railway: add a Postgres service, then add a variable reference:
#   Variable name : DATABASE_URL
#   Value         : ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Session encryption secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# If omitted, a fallback is derived from DATABASE_URL (less secure).
SESSION_SECRET=change_this_to_a_long_random_secret_string

# ── OPTIONAL ────────────────────────────────────────────────────────

# Runtime environment. Railway sets this automatically.
NODE_ENV=production

# HTTP port. Railway sets this automatically — do NOT hardcode.
# PORT=3000

# Public URL of your app (used for CORS). Leave empty to allow all.
# APP_URL=https://your-app.railway.app

# ── NOT NEEDED AT DEPLOY TIME ────────────────────────────────────────
#
# All TeamSpeak credentials, admin account, and channel IDs are
# configured through the First-Time Setup Wizard (/setup) that
# appears the first time you open the app.
#
# They are stored securely in the PostgreSQL database — NOT in env vars.
#
# What the setup wizard collects:
#   TS_HOST           — TeamSpeak server hostname or IP
#   TS_SERVER_PORT    — Game port (e.g. 9987) — used to auto-detect virtual server
#   TS_QUERY_PORT     — ServerQuery port (e.g. 10011)
#   TS_QUERY_USERNAME — ServerQuery username
#   TS_QUERY_PASSWORD — ServerQuery password
#   ADMIN_USERNAME    — Panel admin username
#   ADMIN_PASSWORD    — Panel admin password
#
# Note: Virtual Server ID is detected AUTOMATICALLY from the server port.
# You never need to look up or enter a Virtual Server ID.
